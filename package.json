{
  "name": "sag",
  "version": "0.1.0",
  "description": "SAG: event-centric retrieval with TypeScript, PostgreSQL/pgvector, HTTP and MCP interfaces.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx src/index.ts",
    "dev:api:watch": "tsx watch src/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node dist/src/index.js",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:setup": "npm run db:migrate && npm run seed",
    "db:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-db.ps1",
    "db:restore": "powershell -ExecutionPolicy Bypass -File scripts/restore-db.ps1",
    "seed": "tsx src/db/seed.ts",
    "mcp": "tsx scripts/run-mcp.ts",
    "demo:ingest": "tsx scripts/demo-ingest.ts",
    "demo:search": "tsx scripts/demo-search.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^11.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.8",
    "gpt-tokenizer": "^3.4.0",
    "lucide-react": "^1.17.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "stream-json": "1.9.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/stream-json": "1.7.8",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "8.4.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "shell-quote": "1.11.0",
    "@hono/node-server": "2.1.3",
    "body-parser": "2.4.0",
    "fast-uri@3": "3.1.9",
    "ip-address": "10.7.4",
    "hono": "4.13.16",
    "dompurify": "3.4.17",
    "qs": "6.16.1",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0",
    "postcss-selector-parser": "6.1.5"
  }
}
